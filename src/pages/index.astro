---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const isDev = import.meta.env.DEV;
const posts = (await getCollection('posts', ({ data }) => isDev || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featuredPresentations = [
  {
    title: 'The Door of Reconciliation',
    description:
      "Pastor Evan Knott's July 11th sermon on the historic 'chancing your arm' story at St. Patrick's Cathedral and Ephesians 2 — how Christ's cross opens the door between enemies and calls the church to become partners of peace in a divided world.",
    href: `${base}/presentations/the-door-of-reconciliation/`,
    tag: 'Sermon Presentation',
    meta: 'Standalone slideshow · 19 slides · July 11, 2026',
  },
  {
    title: 'The Power That Changed the Universe',
    description:
      "A Sabbath School study on First Corinthians — how Paul confronts Corinth's obsession with wealth, rhetoric, and status with a crucified Christ, and why the cross settles the Great Controversy's argument over God's power.",
    href: `${base}/presentations/the-power-that-changed-the-universe/`,
    tag: 'Sabbath School Presentation',
    meta: 'Standalone slideshow · 11 slides · July 11, 2026',
  },
  {
    title: 'Mark 12:18-44 — Debate, Devotion, and True Religion',
    description:
      "A Wednesday Night Prayer Meeting study on Jesus' final temple-court encounters in Holy Week — the Sadducees' resurrection riddle, the great commandment, the Messiah riddle, the warning against false piety, and the widow's offering.",
    href: `${base}/presentations/mark-12-debate-devotion-true-religion/`,
    tag: 'Prayer Meeting Presentation',
    meta: 'Standalone slideshow · 10 slides · July 8, 2026',
  },
  {
    title: 'Whose Side Are We On?',
    description:
      "Pastor Evan Knott's July 4th sermon on Joshua 5:13-15 — how the Commander of the Lord's Army corrects Joshua's instinct to recruit God into his conflict, and calls every believer to stop asking whether God is on our side and start asking whether we are on His.",
    href: `${base}/presentations/whose-side-are-we-on/`,
    tag: 'Sermon Presentation',
    meta: 'Standalone slideshow · 18 slides · July 4, 2026',
  },
  {
    title: 'The Demas Condition',
    description:
      "A sermon presentation by Dr. Chukwuma I. Onyeije, MD, FACOG examining 'The Demas Condition'—a state where outer spiritual indicators appear healthy while the inner heart is drifting away from God.",
    href: `${base}/presentations/the-demas-condition-sermon/`,
    tag: 'Sermon Presentation',
    meta: 'Interactive website · 18 slides · June 2026',
  },
  {
    title: "Under the Broom Tree: Elijah's Depression",
    description:
      'A sermon presentation on 1 Kings 19. How God deals gently with the physical exhaustion, mental fatigue, and depression of His prophet Elijah — meeting collapse with care, presence, truth, and a future.',
    href: `${base}/presentations/under-the-broom-tree/`,
    tag: 'Sermon Presentation',
    meta: 'Standalone slideshow · 10 slides · May 2026',
  },
  {
    title: 'Into Eternity',
    description:
      'A Sabbath School presentation on the eschatological journey from the struggles of a fallen world to the glorious hope of the New Jerusalem. Covers the core tension of living between two realms, spiritual renewal, the anatomy of Christ\'s return, the Bride of Christ, and the architecture of the New Jerusalem.',
    href: `${base}/presentations/into-eternity/`,
    tag: 'Sabbath School Presentation',
    meta: 'Standalone slideshow · 13 slides · June 22, 2026',
  },
  {
    title: 'Share Him — Growing in a Relationship With God',
    description:
      'A Sabbath School presentation for Lesson 12 (Q2 2026) on witnessing as the organic overflow of life with Christ. Covers the Great Commission, compassion-driven outreach, practical tips for sharing Jesus, caring for wandering loved ones, and three key principles of gospel witness.',
    href: `${base}/presentations/share-him/`,
    tag: 'Sabbath School Presentation',
    meta: 'Standalone slideshow · 11 slides · June 19, 2026',
  },
  {
    title: 'Setbacks into Gold',
    description:
      'A Sabbath School study on growing through adversity — covering four biblical archetypes (the Sudden Storm, the Chronic Burden, the Inexplicable Loss, and Shattered Expectations) drawn from Romans 5, Mark 4–5, Job, and Luke 24.',
    href: `${base}/presentations/setbacks-into-gold/`,
    tag: 'Sabbath School Presentation',
    meta: 'Standalone slideshow · 14 slides · June 13, 2026',
  },
  {
    title: 'The Crossroads of Destiny',
    description:
      'A sermon on discipleship from Luke 5:1-11. Jesus meets us at the crossroads of our lives and calls us to follow Him into deeper waters.',
    href: `${base}/crossroads-destiny/`,
    tag: 'Sermon Presentation',
    meta: 'Interactive website · 18 slides · Audio narration · May 30, 2026',
  },
  {
    title: 'Elements of Biblical Hermeneutics',
    description:
      "A standalone elder study on Frank Hasel's Chapter 2 — how Scripture's own self-testimony demands a method open to the supernatural, anchored in the historical-grammatical approach, and accountable to the whole canon.",
    href: `${base}/presentations/elements-of-biblical-hermeneutics/`,
    tag: 'Elder Study Presentation',
    meta: 'Standalone slideshow · 15 slides · May 2026',
  },
  {
    title: 'Biblical Hermeneutics: An Adventist Approach',
    description:
      'A standalone study on presuppositions, sola Scriptura, the Holy Spirit, and the disciplined practice of letting Scripture correct the reader.',
    href: `${base}/presentations/biblical-hermeneutics-an-adventist-approach/`,
    tag: 'Theology Presentation',
    meta: 'Standalone slideshow - 18 slides - May 24, 2026',
  },
  {
    title: 'Adults Try, Children Trust',
    description:
      "Pastor Evan Knott's first sermon at Atlanta North Seventh-day Adventist Church, calling hearers from anxious striving into the childlike peace of belonging to Christ.",
    href: `${base}/presentations/adults-try-children-trust/`,
    tag: 'Sermon Presentation',
    meta: 'Standalone slideshow · 18 slides · May 16, 2026',
  },
  {
    title: 'The Text and the Canon of Scripture',
    description:
      "A standalone elder study on Gerald Klingbeil's chapter about canon, textual transmission, translation, and Scripture's authority under Adventist theology.",
    href: `${base}/presentations/the-text-and-the-canon-of-scripture/`,
    tag: 'Elder Study Presentation',
    meta: 'Standalone slideshow · 20 slides',
  },
  {
    title: 'Revelation and Inspiration',
    description:
      "A standalone elder-study presentation on Fernando Canale's doctrine of Scripture and why revelation and inspiration shape every Adventist act of interpretation.",
    href: `${base}/presentations/revelation-and-inspiration/`,
    tag: 'Elder Study Presentation',
    meta: 'Standalone slideshow · 15 slides',
  },
  {
    title: 'Faith, Reason, and the Holy Spirit in Hermeneutics',
    description:
      'A standalone elder study on sanctified reason, faithful interpretation, and why the Holy Spirit is indispensable in Adventist hermeneutics.',
    href: `${base}/presentations/faith-reason-and-the-holy-spirit-in-hermeneutics/`,
    tag: 'Elder Study Presentation',
    meta: 'Standalone slideshow · 9 slides',
  },
  {
    title: 'Demas and the Drift',
    description:
      'A standalone Atlanta North vespers slideshow exploring how spiritual drift often begins long before collapse becomes visible.',
    href: `${base}/presentations/demas-and-the-drift-vespers/`,
    tag: 'Vespers Presentation',
    meta: 'Standalone slideshow · 30 slides',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chukwuma Theology | Theology, Truth, and Christian Reflection</title>
    <meta name="description" content="Exploring the intersection of Seventh-day Adventist theology, biblical truth, and our shared history." />
    <style>
      /* ── Hero ───────────────────────────────────── */
      .hero {
        background:
          linear-gradient(rgba(45, 71, 57, 0.82), rgba(45, 71, 57, 0.82)),
          url('https://images.unsplash.com/photo-1507413245164-6160d8298b31?auto=format&fit=crop&q=80&w=2070')
          center / cover no-repeat;
        color: var(--white);
        padding: 100px 0;
        text-align: center;
      }

      .hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        line-height: 1.2;
        margin-bottom: 20px;
        color: var(--white);
      }

      .hero p {
        font-size: 1.15rem;
        max-width: 680px;
        margin: 0 auto 30px;
        opacity: 0.9;
      }

      /* ── Posts grid ─────────────────────────────── */
      .posts-section {
        padding: 80px 0;
      }

      .section-title {
        text-align: center;
        margin-bottom: 50px;
      }

      .section-title h2 {
        font-family: 'Playfair Display', serif;
        font-size: 2.25rem;
        color: var(--primary);
        margin-bottom: 10px;
      }

      .section-title p {
        color: var(--text-muted);
        font-size: 1rem;
      }

      .card-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
      }

      .card {
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        border-top: 5px solid var(--accent);
        transition: transform 0.25s;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .card:hover { transform: translateY(-5px); }

      .card-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
        flex-shrink: 0;
      }

      .card-body {
        padding: 28px 32px 32px;
        display: flex;
        flex-direction: column;
        flex: 1;
      }

      .card-tag {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--secondary);
        font-weight: 700;
        margin-bottom: 12px;
      }

      .card h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        color: var(--primary);
        margin-bottom: 12px;
        line-height: 1.3;
      }

      .card p {
        font-size: 0.95rem;
        color: #555;
        flex: 1;
      }

      .card-meta {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 8px;
      }

      .read-more {
        display: inline-block;
        margin-top: 20px;
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
      }

      .read-more:hover { color: var(--secondary); }

      .section-copy {
        color: var(--text-muted);
        font-size: 1rem;
        max-width: 700px;
        margin: 0 auto;
      }

      /* ── About strip ────────────────────────────── */
      .about-strip {
        background: var(--primary);
        color: var(--white);
        padding: 70px 0;
        text-align: center;
      }

      .about-strip h2 {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        color: var(--accent);
        margin-bottom: 16px;
      }

      .about-strip p {
        max-width: 680px;
        margin: 0 auto;
        opacity: 0.9;
        font-size: 1rem;
        line-height: 1.7;
      }
    </style>
  </head>
  <body>

    <header class="site-header">
      <nav class="site-nav container">
        <a href={base} class="logo">Chukwuma <span>Theology</span></a>
        <ul class="nav-links">
          <li><a href="#about">About</a></li>
          <li><a href="#studies">Bible Studies</a></li>
          <li><a href="#presentations">Presentations</a></li>
          <li><a href="https://chukwumatheology.substack.com/" target="_blank" rel="noopener">Substack</a></li>
          <li><a href="#contact">Connect</a></li>
        </ul>
      </nav>
    </header>

    <section class="hero">
      <div class="container">
        <h1>Theology, Truth, and Christian Reflection</h1>
        <p>Exploring the intersection of Seventh-day Adventist theology, biblical truth, and our shared history.</p>
        <a href="#studies" class="btn">Start Exploring</a>
      </div>
    </section>

    <main>

      <section id="studies" class="posts-section">
        <div class="container">
          <div class="section-title">
            <h2>Latest Reflections</h2>
            <p>Actionable insights for deeper scriptural understanding.</p>
          </div>

          <div class="card-container">
            {posts.map((post) => (
              <article class="card">
                {post.data.image && (
                  <img class="card-img" src={post.data.image.url} alt={post.data.image.alt} />
                )}
                <div class="card-body">
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="card-tag">{post.data.tags[0]}</div>
                  )}
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <div class="card-meta">
                    {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </div>
                  <a href={`${base}/posts/${post.id.replace(/\.mdx?$/, '')}/`} class="read-more">Read More →</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="presentations" class="posts-section">
        <div class="container">
          <div class="section-title">
            <h2>Presentations</h2>
            <p class="section-copy">Standalone talks and slide decks published directly on the site for reading, teaching, and sharing.</p>
          </div>

          <div class="card-container">
            {featuredPresentations.map((presentation) => (
              <article class="card">
                <div class="card-body">
                  <div class="card-tag">{presentation.tag}</div>
                  <h3>{presentation.title}</h3>
                  <p>{presentation.description}</p>
                  <div class="card-meta">{presentation.meta}</div>
                  <a href={presentation.href} class="read-more">Open Presentation →</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="about-strip">
        <div class="container">
          <h2>About This Space</h2>
          <p>
            I am Chukwuma I. Onyeije, MD, FACOG — a physician, Seventh-day Adventist, and student of scripture.
            This blog is where medicine, theology, and thoughtful reflection meet.
            Every post is an invitation to think more carefully about what we believe and why.
          </p>
        </div>
      </section>

    </main>

    <footer id="contact" class="site-footer">
      <div class="container">
        <p>&copy; 2026 Chukwuma I. Onyeije, MD. Faith-based reflections for a modern world.</p>
      </div>
    </footer>

  </body>
</html>
