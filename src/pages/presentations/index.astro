---
import presentationsData from '../../data/presentations.json';
import '../../styles/global.css';
import Pagination from '../../components/Pagination.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://chukwumaonyeije.github.io/chukwuma-theology';

// Let's set a page size of 6 for testing/demonstration of pagination
const pageSize = 6;
const totalPages = Math.ceil(presentationsData.length / pageSize);
const currentPage = 1;

const paginatedPresentations = presentationsData.slice(0, pageSize);
const canonicalUrl = `${siteUrl}/presentations/`;
const nextUrl = totalPages > 1 ? `${base}/presentations/page/2/` : null;

// Dynamic thumbnail color block generator based on presentation tag
const getThumbnailStyle = (tag: string) => {
  const t = tag.toLowerCase();
  if (t.includes('sabbath')) return 'background: linear-gradient(135deg, var(--primary) 0%, #1a2c22 100%); color: var(--bg-light);';
  if (t.includes('sermon')) return 'background: linear-gradient(135deg, var(--secondary) 0%, #8e4c31 100%); color: var(--white);';
  if (t.includes('elder')) return 'background: linear-gradient(135deg, var(--accent) 0%, #b8962d 100%); color: var(--text-dark);';
  if (t.includes('vespers')) return 'background: linear-gradient(135deg, #3a506b 0%, #1c2541 100%); color: var(--white);';
  return 'background: linear-gradient(135deg, #7c8e83 0%, #5d6e64 100%); color: var(--white);'; // default fallback
};

// ItemList schema for presentations archive
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Theology Presentations Archive - Page 1",
  "description": "Dr. Chukwuma I. Onyeije's presentations on theology, elder studies, and sermon outlines.",
  "numberOfItems": paginatedPresentations.length,
  "itemListElement": paginatedPresentations.map((p, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `${siteUrl}/presentations/${p.slug}/`,
    "name": p.title
  }))
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Presentations Archive — Page {currentPage} | Chukwuma Theology</title>
    <meta name="description" content="Browse and download theological presentations, elder training studies, and slide decks by Dr. Chukwuma I. Onyeije." />
    
    <link rel="canonical" href={canonicalUrl} />
    {nextUrl && <link rel="next" href={`https://chukwumaonyeije.github.io${nextUrl}`} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Presentations Archive | Chukwuma Theology" />
    <meta property="og:description" content="Browse and download theological presentations, elder training studies, and slide decks by Dr. Chukwuma I. Onyeije." />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content="Presentations Archive | Chukwuma Theology" />
    <meta property="twitter:description" content="Browse and download theological presentations, elder training studies, and slide decks by Dr. Chukwuma I. Onyeije." />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

    <style>
      .archive-header {
        padding: 60px 0 40px;
        text-align: center;
        background-color: var(--white);
        border-bottom: 1px solid var(--border);
        margin-bottom: 40px;
      }
      .archive-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        color: var(--primary);
        margin-bottom: 15px;
      }
      .archive-header p {
        color: var(--text-muted);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
      }
      .pres-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin-bottom: 50px;
      }
      .card {
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        transition: transform 0.25s, box-shadow 0.25s;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--border);
      }
      .card:hover { 
        transform: translateY(-5px); 
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
      }
      
      /* Fallback Thumbnail Design */
      .fallback-thumbnail {
        height: 180px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 24px;
        text-align: center;
        position: relative;
        overflow: hidden;
        border-bottom: 4px solid var(--accent);
      }
      .fallback-thumbnail::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(0,0,0,0.1) 100%);
        pointer-events: none;
      }
      .fallback-tag {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 700;
        opacity: 0.85;
        margin-bottom: 8px;
      }
      .fallback-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1.3;
        margin: 0;
        max-height: 70px;
        overflow: hidden;
      }
      .fallback-format-badge {
        position: absolute;
        bottom: 12px;
        right: 12px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(4px);
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 0.65rem;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
      }

      .card-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex: 1;
      }
      .card h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.2rem;
        color: var(--primary);
        margin-bottom: 10px;
        line-height: 1.3;
      }
      .card p {
        font-size: 0.9rem;
        color: #555;
        flex: 1;
        margin-bottom: 15px;
      }
      .card-meta {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 15px;
        border-top: 1px dashed var(--border);
        padding-top: 10px;
      }
      .view-btn {
        display: inline-block;
        background: var(--primary);
        color: var(--white);
        padding: 10px 18px;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.85rem;
        text-align: center;
        transition: background-color 0.2s;
      }
      .view-btn:hover { 
        background: var(--secondary); 
      }
    </style>
  </head>
  <body>

    <header class="site-header">
      <nav class="site-nav container">
        <a href={base} class="logo">Chukwuma <span>Theology</span></a>
        <ul class="nav-links">
          <li><a href={`${base}#about`}>About</a></li>
          <li><a href={`${base}/blog/`}>Reflections</a></li>
          <li><a href={`${base}/presentations/`}>Presentations</a></li>
          <li><a href="https://chukwumatheology.substack.com/" target="_blank" rel="noopener">Substack</a></li>
          <li><a href={`${base}#contact`}>Connect</a></li>
        </ul>
      </nav>
    </header>

    <main class="container">
      <div class="archive-header">
        <h1>Studies & Presentations</h1>
        <p>A library of slide decks, elder training material, and sermon presentations available for reading and download.</p>
      </div>

      <div class="pres-grid">
        {paginatedPresentations.map((p) => (
          <article class="card">
            <div class="fallback-thumbnail" style={getThumbnailStyle(p.tag)}>
              <span class="fallback-tag">{p.tag}</span>
              <h2 class="fallback-title">{p.title}</h2>
              <span class="fallback-format-badge">{p.type}</span>
            </div>
            <div class="card-body">
              <p>{p.description}</p>
              <div class="card-meta">
                {p.meta}
              </div>
              <a href={p.type === 'pdf' ? `${base}/presentations/${p.slug}/` : (p.url.startsWith('/') ? `${base}${p.url}` : p.url)} class="view-btn">
                {p.type === 'pdf' ? 'Open Landing Page →' : 'Open Slide Deck →'}
              </a>
            </div>
          </article>
        ))}
      </div>

      {totalPages > 1 && (
        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          prevUrl={null}
          nextUrl={nextUrl}
          baseUrl={`${base}/presentations`}
        />
      )}
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; 2026 Chukwuma I. Onyeije, MD. Faith-based reflections for a modern world.</p>
      </div>
    </footer>

  </body>
</html>
