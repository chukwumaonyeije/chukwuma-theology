---
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import Pagination from '../../components/Pagination.astro';

const isDev = import.meta.env.DEV;
const posts = (await getCollection('posts', ({ data }) => isDev || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pageSize = 10;
const totalPages = Math.ceil(posts.length / pageSize);
const currentPage = 1;

const paginatedPosts = posts.slice(0, pageSize);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://chukwumaonyeije.github.io/chukwuma-theology';
const canonicalUrl = `${siteUrl}/blog/`;
const nextUrl = totalPages > 1 ? `${base}/blog/page/2/` : null;

// JSON-LD ItemList Schema
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Chukwuma Theology Blog Archive - Page 1",
  "description": "Reflections on Seventh-day Adventist theology, biblical studies, and medical ethics.",
  "numberOfItems": paginatedPosts.length,
  "itemListElement": paginatedPosts.map((post, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `${siteUrl}/posts/${post.slug}/`,
    "name": post.data.title
  }))
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Archive — Page {currentPage} | Chukwuma Theology</title>
    <meta name="description" content="Explore faith-based reflections, elder studies, and theological discussions by Dr. Chukwuma I. Onyeije." />
    
    <link rel="canonical" href={canonicalUrl} />
    {nextUrl && <link rel="next" href={`https://chukwumaonyeije.github.io${nextUrl}`} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Blog Archive | Chukwuma Theology" />
    <meta property="og:description" content="Explore faith-based reflections, elder studies, and theological discussions by Dr. Chukwuma I. Onyeije." />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content="Blog Archive | Chukwuma Theology" />
    <meta property="twitter:description" content="Explore faith-based reflections, elder studies, and theological discussions by Dr. Chukwuma I. Onyeije." />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

    <style>
      .archive-header {
        padding: 60px 0 40px;
        text-align: center;
        background-color: var(--white);
        border-bottom: 1px solid var(--border);
        margin-bottom: 40px;
      }
      .archive-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        color: var(--primary);
        margin-bottom: 15px;
      }
      .archive-header p {
        color: var(--text-muted);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
      }
      .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin-bottom: 50px;
      }
      .card {
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        border-top: 5px solid var(--accent);
        transition: transform 0.25s;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .card:hover { transform: translateY(-5px); }
      .card-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
        flex-shrink: 0;
      }
      .card-body {
        padding: 28px 32px 32px;
        display: flex;
        flex-direction: column;
        flex: 1;
      }
      .card-tag {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--secondary);
        font-weight: 700;
        margin-bottom: 12px;
      }
      .card h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        color: var(--primary);
        margin-bottom: 12px;
        line-height: 1.3;
      }
      .card p {
        font-size: 0.95rem;
        color: #555;
        flex: 1;
      }
      .card-meta {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 8px;
      }
      .read-more {
        display: inline-block;
        margin-top: 20px;
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
      }
      .read-more:hover { color: var(--secondary); }
    </style>
  </head>
  <body>

    <header class="site-header">
      <nav class="site-nav container">
        <a href={base} class="logo">Chukwuma <span>Theology</span></a>
        <ul class="nav-links">
          <li><a href={`${base}#about`}>About</a></li>
          <li><a href={`${base}#studies`}>Bible Studies</a></li>
          <li><a href="https://chukwumatheology.substack.com/" target="_blank" rel="noopener">Substack</a></li>
          <li><a href={`${base}#contact`}>Connect</a></li>
        </ul>
      </nav>
    </header>

    <main class="container">
      <div class="archive-header">
        <h1>Latest Reflections</h1>
        <p>A chronological archive of written theological insights, scriptural analysis, and commentary.</p>
      </div>

      <div class="posts-grid">
        {paginatedPosts.map((post) => (
          <article class="card">
            {post.data.image && (
              <img class="card-img" src={post.data.image.url} alt={post.data.image.alt} />
            )}
            <div class="card-body">
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="card-tag">{post.data.tags[0]}</div>
              )}
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="card-meta">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </div>
              <a href={`${base}/posts/${post.slug}/`} class="read-more">Read More →</a>
            </div>
          </article>
        ))}
      </div>

      {totalPages > 1 && (
        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          prevUrl={null}
          nextUrl={nextUrl}
          baseUrl={`${base}/blog`}
        />
      )}
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; 2026 Chukwuma I. Onyeije, MD. Faith-based reflections for a modern world.</p>
      </div>
    </footer>

  </body>
</html>
